# Keep the web UI on localhost unless it is protected by an authenticated HTTPS proxy.
BACKREST_BIND_ADDRESS=127.0.0.1
BACKREST_HOST_PORT=9898
TZ=Etc/UTC

# Host paths, relative to the Compose project directory by default.
# The source is mounted read-only; restores go to the separate writable target.
BACKREST_SOURCE_PATH=./backup-source
BACKREST_RESTORE_PATH=./restore-target

# Local Restic repository storage (not needed for remote repositories such as S3).
BACKREST_REPOSITORY_PATH=./repositories
